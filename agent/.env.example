# Copy this file to .env and fill in your values. Never commit .env.

# ---- Model
# Which model provider the agent uses: gemini (free tier) or claude (paid API credits)
PROVIDER=gemini
GEMINI_API_KEY=your-key-here
ANTHROPIC_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- Database
# Which profile (profiles/<name>.toml): porsche, chinook, or generic for any database without a profile file
DB_PROFILE=porsche

# Option A - any database, one line (connect with a READ-ONLY user):
# DATABASE_URL=postgresql://agent_reader:password@localhost:5432/shop
# DATABASE_URL=mssql+pymssql://agent_reader:password@localhost:1433/Porsche
# DATABASE_URL=sqlite:///data/chinook.sqlite
#
# Option B - the original SQL Server settings for the Porsche database (see SETUP.md):
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Porsche
DB_USER=agent_reader
DB_PASSWORD=Reader!Passw0rd
#
# With neither A nor B, the profile's own database is used - for porsche, the SQLite copy in data/.
